{
  "name": "@vysor/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Mirrox desktop app",
  "author": "Mirrox",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "package": "npm run build && electron-builder --mac --dir",
    "package:dmg": "npm run build && electron-builder --mac dmg --arm64",
    "package:intel": "npm run build && electron-builder --mac dmg --x64",
    "package:all": "npm run package:dmg && npm run package:intel",
    "prepackage": "npm run vendor:arm64 --prefix ../..",
    "prepackage:dmg": "npm run vendor:arm64 --prefix ../..",
    "prepackage:intel": "npm run vendor:x64 --prefix ../.."
  },
  "dependencies": {
    "@vysor/adb": "*",
    "@vysor/mirror": "*"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "build": {
    "appId": "com.mirrox.app",
    "productName": "Mirrox",
    "electronVersion": "35.7.5",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      {
        "from": "../../packages/adb/dist",
        "to": "node_modules/@vysor/adb/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../../packages/adb/package.json",
        "to": "node_modules/@vysor/adb/package.json"
      },
      {
        "from": "../../packages/mirror/dist",
        "to": "node_modules/@vysor/mirror/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../../packages/mirror/package.json",
        "to": "node_modules/@vysor/mirror/package.json"
      }
    ],
    "extraResources": [
      {
        "from": "../../vendor/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "dir"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "asar": true
  }
}
