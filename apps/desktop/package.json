{
  "name": "@mirrox/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Mirrox desktop app",
  "author": "Mirrox",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "package": "npm run build && electron-builder --mac --dir",
    "package:dmg": "npm run build && electron-builder --mac dmg --arm64",
    "package:intel": "npm run build && electron-builder --mac dmg --x64",
    "package:all": "npm run package:dmg && npm run package:intel",
    "prepackage": "npm run vendor:arm64 --prefix ../..",
    "prepackage:dmg": "npm run vendor:arm64 --prefix ../..",
    "prepackage:intel": "npm run vendor:x64 --prefix ../.."
  },
  "dependencies": {
    "@mirrox/adb": "*",
    "@mirrox/mirror": "*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "build": {
    "appId": "com.mirrox.app",
    "productName": "Mirrox",
    "electronVersion": "39.8.10",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.icns",
    "files": [
      "out/**/*",
      "package.json",
      {
        "from": "../../packages/adb/dist",
        "to": "node_modules/@mirrox/adb/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../packages/adb/package.json",
        "to": "node_modules/@mirrox/adb/package.json"
      },
      {
        "from": "../../packages/mirror/dist",
        "to": "node_modules/@mirrox/mirror/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../packages/mirror/package.json",
        "to": "node_modules/@mirrox/mirror/package.json"
      }
    ],
    "extraResources": [
      {
        "from": "../../vendor/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.icns",
        "to": "icon.icns"
      },
      {
        "from": "resources/scrcpy-icons",
        "to": "scrcpy-icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleName": "Mirrox",
        "CFBundleDisplayName": "Mirrox"
      },
      "target": [
        "dmg",
        "dir"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "moezbenselem",
        "repo": "Mirrox"
      }
    ],
    "asar": true
  }
}
